# Copy to .env and fill in real values. .env is git-ignored; never commit it.

POSTGRES_DB=smart_spend
POSTGRES_USER=smart_spend
POSTGRES_PASSWORD=change-me

# Host port for PostgreSQL (bound to 127.0.0.1 only). Use a different port per worktree/agent.
# The shelf server reads this same file (server_app/lib/db/db_config.dart).
DB_PORT=5432

# Optional: host the server connects to. Defaults to localhost.
# DB_HOST=localhost

# Required: HS256 signing key for login tokens, at least 32 bytes. Left empty
# on purpose so the server refuses to start until you set a real one:
#   openssl rand -base64 48
JWT_SECRET=

# Optional: bcrypt cost factor (4-31). Defaults to 12.
# BCRYPT_COST=12
